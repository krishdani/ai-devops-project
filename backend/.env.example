# ── Flask ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=true
PORT=5000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_GENERATION_INTERVAL=5

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose "openai" or "anthropic"
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# How many log lines per AI analysis batch
AI_LOG_BATCH_SIZE=50

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=

# CloudWatch
CLOUDWATCH_LOG_GROUP=/ai-devops-platform/application
CLOUDWATCH_LOG_STREAM=app-stream

# ── Alert Thresholds ─────────────────────────────────────────────────────────
ERROR_ALERT_THRESHOLD=5
ERROR_ALERT_WINDOW_MINUTES=5
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AWS=false
ENABLE_AI_ANALYSIS=true
ENABLE_SNS_ALERTS=false
ENABLE_CLOUDWATCH=false
